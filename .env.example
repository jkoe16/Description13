# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않아요)
OPENAI_API_KEY=
# 선택: 기본값 gpt-6-luna
OPENAI_MODEL=
# 선택: 기본값 none (모델이 지원하는 값: none, low, medium ...)
OPENAI_REASONING_EFFORT=

# Firebase 로그인 (Firebase 콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱의 firebaseConfig 값)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# 마음 대화를 쓸 수 있는 이메일 (쉼표로 구분). 비어 있으면 아무도 못 써요.
ALLOWED_EMAILS=
